# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# AMD Token Factory (OpenAI-compatible). Get the exact base URL + model name
# from the model's detail dialog in the Token Factory console.
# Global portal: https://notebooks.amd.com/tokenfactory
#
# --- Configuration for the LIVE client (used by demos, not by tests) ---
MARKETPULSE_LLM_BACKEND=amd        # amd | mock
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=rc-REPLACE_WITH_YOUR_KEY
AMD_MODEL=DeepSeek-V4.1-Flash      # recommended by scripts/model_selection.py (see docs/MODEL_SELECTION.md)
AMD_TIMEOUT_S=60
AMD_MAX_RETRIES=3
AMD_TEMPERATURE=0.0                # deterministic extraction/explanation

# Confidence threshold below which extraction asks a follow-up question
LLM_CONFIDENCE_THRESHOLD=0.6

# Audit log destination (JSONL)
LLM_AUDIT_PATH=llm/audit/audit.jsonl
